{
  "name": "values-cards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9",
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint .",
    "token:lint": "node scripts/token-lint.mjs",
    "spec:status": "node scripts/spec-status.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "gate": "pnpm run typecheck && pnpm run lint && pnpm run token:lint && pnpm run test:unit && pnpm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.0.0"
  }
}
