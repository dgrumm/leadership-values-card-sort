{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "values-cards-party",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "Session",
        "class_name": "SessionServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionServer"]
    }
  ]
}
